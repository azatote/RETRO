{
  "installCommand": "cd RETRO-main && node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\" && npm ci --include=optional --registry=https://registry.npmjs.org --cache=/tmp/retro-npm-cache",
  "buildCommand": "cd RETRO-main && npm run build",
  "outputDirectory": "RETRO-main/dist"
}
